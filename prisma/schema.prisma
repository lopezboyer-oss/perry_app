generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS (using String fields) ────────────────────────────────

// Role: ADMIN, ADMINISTRACION, SUPERVISOR, SUPERVISOR_SAFETY_LP, INGENIERO
// ActivityType: VISITA_CAMPO, COTIZACION, EJECUCION, PLANEACION, DISENO, CONSORCIO
// ActivityStatus: PENDIENTE, EN_PROGRESO, COMPLETADA, CANCELADA
// OpportunityStatus: EN_PROGRESO, COMPLETADA (derived from Activities, not stored)
// ReportSource: MANUAL, WHATSAPP_IMPORT
// TechnicianType: PROPIO, EXTERNO

// ─── MODELS ─────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String
  passwordPlaintext String?               // Contraseña en texto plano para compartir acceso (solo visible para ADMIN)
  role              String    @default("INGENIERO")
  isActive          Boolean   @default(true)
  isSafetyDesignado Boolean   @default(false)
  isSafetyAuditor   Boolean   @default(false)   // Enables editing Auditoría + TERA Auditor
  accessSafetyDedicado Boolean @default(false)
  accessVehicles       Boolean @default(false)
  accessDrivers        Boolean @default(false)
  accessElevationEquip Boolean @default(false)
  accessManPower       Boolean @default(false) // Permiso para acceder al dashboard Man Power
  accessCrearPlanes    Boolean @default(false) // Permiso para crear y editar planes de trabajo (nivel supervisor)
  excludeFromCompanyLogs Boolean @default(false) // Hide from company-filtered attendance logs (for transversal roles like Safety)
  supervisorId      String?
  supervisor        User?     @relation("SupervisorTeam", fields: [supervisorId], references: [id])
  team              User[]    @relation("SupervisorTeam")
  baseCompanyId     String?
  baseCompany       Company?  @relation("UserBaseCompany", fields: [baseCompanyId], references: [id])
  weeklySalary      Float?    @default(0) // Salario Semanal Bruto (MXN)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  companies     UserCompany[]
  activities    Activity[]
  dailyReports  DailyReport[]
  userSafetyAssignments WeekendUserSafetyAssignment[]
  invoiceReceipts InvoiceReceipt[]
  timeClockEntries TimeClockEntry[]
  odooFolioComments OdooFolioComment[]
}

model Client {
  id        String    @id @default(cuid())
  name      String
  code      String?   @unique
  status    String    @default("ACTIVO")
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  contacts      Contact[]
  activities    Activity[]
}

model Contact {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  position  String?
  email     String?
  phone     String?
  notes     String?

  activities    Activity[]
}

model DailyReport {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  reportDate DateTime
  rawText    String
  source     String   @default("MANUAL")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activities Activity[]
}

model Activity {
  id              String       @id @default(cuid())
  dailyReportId   String?
  dailyReport     DailyReport? @relation(fields: [dailyReportId], references: [id])
  userId          String?
  user            User?        @relation(fields: [userId], references: [id])
  clientId        String?
  client          Client?      @relation(fields: [clientId], references: [id])
  contactId       String?
  contact         Contact?     @relation(fields: [contactId], references: [id])
  workOrderFolio  String?
  purchaseOrder   String?
  loto            Boolean      @default(false)
  date            DateTime
  type            String
  status          String       @default("PENDIENTE")
  projectArea     String?
  title           String
  result          String?
  nextStep        String?
  commitmentDate  DateTime?
  startTime       String?
  endTime         String?
  actualStartTime String?
  actualEndTime   String?
  durationMinutes Int?
  location        String?
  notes           String?
  weekendNotes    String?
  auditNotes      String?
  alertNotes      String?              // Safety alert notes (only SUPERVISOR_SAFETY_LP can edit)
  safetyAuditImage String?            // Base64 data URL of safety audit screenshot
  teraFolio        String?            // TERA folio number (e.g. BC-1234)
  teraUploadedAt   DateTime?          // When the TERA image was uploaded
  teraUploadedBy   String?            // Name of user who uploaded the TERA image
  teraAuditorFolio       String?      // TERA Auditor folio number
  teraAuditorUploadedAt  DateTime?    // When the auditor TERA was uploaded
  teraAuditorUploadedBy  String?      // Name of user who uploaded auditor TERA
  teraAuditorImage       String?      // Base64 data URL of auditor TERA image
  teraExempt             Boolean  @default(false)  // Activity doesn't require TERA (set by Safety & LP)
  teraExemptBy           String?                    // Name of user who marked it exempt
  consortiumCompany String?            // Target company when type=CONSORCIO (e.g. DROBOTS)
  continuedFromId  String?             // ID of the parent activity if created via "Continuar"
  cancelledAt      DateTime?           // When the activity was cancelled
  cancelReason     String?             // Selectable reason key for KPI (e.g. PERMISOLOGIA_INCOMPLETA)
  cancelNotes      String?             // Free-text cancellation details
  cancelHasCharges Boolean?            // Whether the cancellation generates client charges
  cancelledBy      String?             // Name of user who cancelled
  cancelledResources String?            // JSON snapshot of resource assignments before cancellation (for undo)
  actualTechCount    Int?               // Manual override for total technician count (for KPI analysis)
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id])
  isManPower      Boolean      @default(false)
  manPowerEquipo  String?      // 6-character alphanumeric ID for Man Power
  manPowerPhotos  String?      @db.Text // JSON array of uploaded photos [{id, url, uploadedBy, uploadedAt}]
  techToken1            String?             // Token for Cuadrilla/Tech 1 public access link
  techToken2            String?             // Token for Cuadrilla/Tech 2 public access link
  clientToken           String?             // Token for Client public view link
  equipmentStatus       String?             // OPERATIVO | FUERA_DE_SERVICIO | DEGRADADO
  suggestedAction       String?             // Suggested action for client
  photosBefore          String?      @db.Text // JSON array [{id, url, uploadedAt, uploadedBy}]
  photosAfter           String?      @db.Text // JSON array [{id, url, uploadedAt, uploadedBy}]
  clientAcknowledged    Boolean      @default(false) // Client "Enterado" flag
  clientAcknowledgedAt  DateTime?           // When client clicked "Enterado"
  clientAcknowledgedBy  String?             // Name/Author of client representative
  clientComments        String?      @db.Text // JSON array [{id, author, comment, createdAt}]
  pendingItems          String?      @db.Text // JSON array [{id, title, status, createdBy, createdAt, closedAt, closedBy}]
  reportSource          String?      @default("MANUAL") // MANUAL | WHATSAPP_BOT | CAMPO_WEB
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  weekendTechAssignments    WeekendTechAssignment[]
  weekendSafetyAssignments  WeekendSafetyAssignment[]
  weekendVehicleAssignments WeekendVehicleAssignment[]
  weekendDriverAssignments  WeekendDriverAssignment[]
  weekendEquipAssignments   WeekendEquipAssignment[]
  weekendUserSafetyAssignments WeekendUserSafetyAssignment[]
  timeRegistryEntries          TimeRegistryEntry[]
  timeClockEntries             TimeClockEntry[]
  equipRecords                 EquipRecord[]
  parts                        ActivityPart[]
  whatsappLogs                 WhatsappMessageLog[]
}

model OdooOrderAccessLink {
  id                    String    @id @default(cuid())
  workOrderFolio        String    @unique
  techToken1            String?   @unique
  techToken2            String?   @unique
  clientToken           String?   @unique
  clientComments        String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ─── REGISTRO HORARIO ───────────────────────────────────────────

model TimeRegistryEntry {
  id           String   @id @default(cuid())
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  phase        String   // "INICIO_LOGISTICO" | "INICIO_OPERATIVO" | "FINAL_OPERATIVO" | "FINAL_LOGISTICO"
  time         String   // "HH:MM" — la hora registrada (ej: "06:30")
  registeredBy String   // Nombre del usuario que registró
  userId       String   // ID del usuario que registró (para futuras queries de nómina)
  registeredAt DateTime @default(now()) // Timestamp exacto del registro

  @@unique([activityId, phase]) // Solo un registro por fase por actividad
  @@index([userId])             // Para queries futuras: horas por persona
  @@index([activityId])         // Para cargar registros de una actividad
}

// ─── PERSONAL OPERATIVO (FINDE) ─────────────────────────────────

model Technician {
  id            String      @id @default(cuid())
  name          String
  type          String      @default("PROPIO") // PROPIO | EXTERNO
  isCruzVerde   Boolean     @default(false)    // Acreditación Safety Designado
  isActive      Boolean     @default(true)
  phone         String?     // Celular para WhatsApp
  email         String?     // Email para envío
  contractorId  String?
  contractor    Contractor? @relation(fields: [contractorId], references: [id])
  baseCompanyId String?
  baseCompany   Company?    @relation(fields: [baseCompanyId], references: [id])
  linkedUserId  String?     // Vinculación con cuenta User de Perry (para permisos y control horario)
  hourlyRate    Float?      @default(0) // Tarifa Horaria (MXN) para técnicos externos
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  weekendAssignments WeekendTechAssignment[]
}

model Contractor {
  id        String       @id @default(cuid())
  name      String       @unique
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  technicians Technician[]
  drivers     Driver[]
}

model SafetyDedicado {
  id            String   @id @default(cuid())
  name          String
  isActive      Boolean  @default(true)
  baseCompanyId String?
  baseCompany   Company? @relation(fields: [baseCompanyId], references: [id])
  linkedUserId  String?  // Vinculación con cuenta User de Perry (para permisos y control horario)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  weekendAssignments WeekendSafetyAssignment[]
}

model Vehicle {
  id            String   @id @default(cuid())
  name          String
  isAvailable   Boolean  @default(true)
  isActive      Boolean  @default(true)
  baseCompanyId String?
  baseCompany   Company? @relation(fields: [baseCompanyId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  weekendAssignments WeekendVehicleAssignment[]
}

model Driver {
  id            String      @id @default(cuid())
  name          String
  type          String      @default("PROPIO") // PROPIO | EXTERNO
  isActive      Boolean     @default(true)
  contractorId  String?
  contractor    Contractor? @relation(fields: [contractorId], references: [id])
  baseCompanyId String?
  baseCompany   Company?    @relation(fields: [baseCompanyId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  weekendAssignments WeekendDriverAssignment[]
}

model ElevationEquip {
  id          String             @id @default(cuid())
  name        String
  ownership   String             @default("PROPIO") // PROPIO | RENTADO
  isActive    Boolean            @default(true)
  costPerDay  Float?             @default(0)        // Costo por jornada (solo RENTADO)
  freightCost Float?             @default(0)        // Costo por flete de traslado
  supplierId  String?
  supplier    EquipmentSupplier? @relation(fields: [supplierId], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  weekendAssignments WeekendEquipAssignment[]
  equipRecords       EquipRecord[]
}

// ─── PROVEEDORES DE EQUIPOS RENTADOS ────────────────────────────────
model EquipmentSupplier {
  id         String           @id @default(cuid())
  name       String           @unique
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  equipments ElevationEquip[]
}

// ─── ASIGNACIONES FINDE ─────────────────────────────────────────

model WeekendTechAssignment {
  id           String     @id @default(cuid())
  activityId   String
  activity     Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  role         String     @default("TECNICO") // TECNICO | SAFETY_DESIGNADO
  weekendOf    String     // "YYYY-MM-DD" del sábado de ese fin de semana
  timeIn       String?    // Hora de inicio logístico (ej. "08:00")
  timeOut      String?    // Hora de final logístico (ej. "18:00")

  @@unique([activityId, technicianId, weekendOf, role])
}

model WeekendSafetyAssignment {
  id               String         @id @default(cuid())
  activityId       String
  activity         Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  safetyDedicadoId String
  safetyDedicado   SafetyDedicado @relation(fields: [safetyDedicadoId], references: [id], onDelete: Cascade)
  role             String         @default("DEDICADO") // DEDICADO or DESIGNADO
  weekendOf        String

  @@unique([activityId, safetyDedicadoId, weekendOf, role])
}

model WeekendVehicleAssignment {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  weekendOf  String

  @@unique([activityId, vehicleId, weekendOf])
}

model WeekendDriverAssignment {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  weekendOf  String

  @@unique([activityId, driverId, weekendOf])
}

model WeekendEquipAssignment {
  id         String         @id @default(cuid())
  activityId String
  activity   Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  equipId    String
  equip      ElevationEquip @relation(fields: [equipId], references: [id], onDelete: Cascade)
  weekendOf  String

  @@unique([activityId, equipId, weekendOf])
}

model WeekendUserSafetyAssignment {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekendOf  String

  @@unique([activityId, userId, weekendOf])
}

// ─── DÍAS EXTRA (Plan ATC Finde) ────────────────────────────────

model ExtraPlanDay {
  id        String   @id @default(cuid())
  date      String   @unique   // "YYYY-MM-DD" del día extra
  weekendOf String              // "YYYY-MM-DD" del sábado asociado
  label     String?             // Etiqueta (ej: "Lunes Festivo")
  createdBy String?             // userId de quien lo creó
  createdAt DateTime @default(now())
}

// ─── COBRANZA ───────────────────────────────────────────────────

model InvoiceReceipt {
  id             String   @id @default(cuid())
  invoiceNumber  String   @unique   // Odoo invoice number (e.g. INV/2026/00149)
  folio          String?             // Odoo folio (e.g. S06254)
  po             String?             // P.O. number
  engineerName   String?             // Responsible engineer name (from Perry activity)
  companyId      String?             // Company this receipt belongs to
  confirmedById  String
  confirmedBy    User     @relation(fields: [confirmedById], references: [id])
  confirmedAt    DateTime @default(now())
  notes          String?
  createdAt      DateTime @default(now())
}

// ─── MULTIEMPRESA ───────────────────────────────────────────────

model Company {
  id          String   @id @default(cuid())
  name        String   @unique              // "GRUPO CASEME"
  shortName   String?                       // "GC", "DR", "VF", "SP", "OI"
  odooId      Int      @unique              // 1, 2, 3, 4, 5
  folioPrefix String                        // "S", "V", "SA", "OS"
  folioFormat String                        // "S#####", "V###", etc.
  color       String?                       // Color hex for UI badges
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  userAccess      UserCompany[]
  baseUsers       User[]           @relation("UserBaseCompany")
  baseTechnicians Technician[]
  baseSafety      SafetyDedicado[]
  baseVehicles    Vehicle[]
  baseDrivers     Driver[]
  activities      Activity[]
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isDefault Boolean  @default(false)   // empresa que se carga al login

  @@unique([userId, companyId])
}

// ─── REGISTRO EQUIPOS ────────────────────────────────────────────

model EquipRecord {
  id         String         @id @default(cuid())
  activityId String
  activity   Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  equipId    String
  equip      ElevationEquip @relation(fields: [equipId], references: [id], onDelete: Cascade)
  weekendOf  String         // "YYYY-MM-DD" del sábado de ese fin de semana

  // Operador
  operatorId        String?
  operatorName      String?
  operatorUpdatedBy String?
  operatorUpdatedAt DateTime?

  // Checklist de seguridad
  chkCondicionesGenerales Boolean  @default(false)
  chkCargaBateria100      Boolean  @default(false)
  chk5sEquipo             Boolean  @default(false)
  chkPaseClienteVigente   Boolean  @default(false)
  chkExtintorFuncional    Boolean  @default(false)
  checklistUpdatedBy      String?
  checklistUpdatedAt      DateTime?

  // Evidencias fotográficas (JSON: [{id, url, uploadedBy, uploadedAt}])
  evidencias String?

  // Notas libres
  notes          String?
  notesUpdatedBy String?
  notesUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([activityId, equipId, weekendOf])
  @@index([weekendOf])
  @@index([activityId])
}

// ─── REGISTRO HORARIO PERSONAL ────────────────────────────────
model TimeClockEntry {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String    // "CHECK_IN" | "CHECK_OUT"
  method           String    // "GPS" | "SELFIE" | "QR" | "MANUAL"
  timestamp        DateTime  @default(now())
  
  // Geolocation
  latitude         Float?
  longitude        Float?
  accuracy         Float?
  
  // Selfie compressed (Base64 JPEG)
  photo            String?   @db.Text
  
  // QR validation metadata
  verifiedByUserId String?   // ID of the supervisor who generated QR
  activityId       String?
  
  // Manual registration metadata (when admin registers on behalf of user)
  registeredByUserId String?  // ID of the admin who created this manual entry
  manualNotes        String?  // Justification note (e.g. "Sin datos en campo")
  activity         Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([activityId])
}

model OdooFolioComment {
  id        String   @id @default(cuid())
  folio     String   // e.g. "S06447"
  content   String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String   // snapshot of user name
  createdAt DateTime @default(now())

  @@index([folio])
}

// ─── REFACCIONES (MAN POWER) ──────────────────────────────────────

model ActivityPart {
  id          String   @id @default(cuid())
  activityId  String
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name        String
  quantity    Int      @default(1)
  status      String   @default("VALIDANDO") // SOLICITADA, COTIZADO, CON_PO, PAGADO, ENTREGADA, INSTALADA, etc.
  providerType String  @default("COTIZAR") // COTIZAR | CLIENTE
  providedBy  String   @default("CASEME")     // CASEME, CLIENTE (legacy or related)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([activityId])
}

// ─── INTEGRACIÓN WHATSAPP (PERRY CO-PILOT) ──────────────────────────

model WhatsappGroupMapping {
  id             String   @id @default(cuid())
  groupId        String   @unique // WhatsApp JID / Group ID e.g. "120363049123456789@g.us"
  groupName      String?
  workOrderFolio String?  // Default Work Order Folio for this group (e.g. "S06447")
  companyId      String?
  groupCategory  String   @default("OPERACIONAL") // OPERACIONAL | COORDINACION | ADMINISTRATIVO_FINANCIERO | CONSORCIO | RESERVADO_DIRECCION
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WhatsappMessageLog {
  id           String    @id @default(cuid())
  messageId    String    @unique // WhatsApp Msg ID for deduplication
  groupId      String?
  senderPhone  String
  senderName   String?
  rawMessage   String?   @db.Text
  mediaUrls    String?   @db.Text // JSON array of uploaded URLs
  parsedData   String?   @db.Text // JSON extracted by Gemini
  activityId   String?
  activity     Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  status       String    @default("PROCESSED") // PROCESSED | PENDING_INFO | FAILED
  missingField String?   // Name of missing field if status is PENDING_INFO (e.g. "manPowerEquipo")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([groupId])
  @@index([senderPhone])
  @@index([activityId])
}

// ─── SEGUIMIENTO DE PUNTOS CRÍTICOS (WhatsApp) ──────────────────────

model CriticalItemTracking {
  id            String    @id @default(cuid())
  itemNumber    Int       // #1, #2, etc.
  issueText     String    @db.Text
  reportedGroup String
  reportedBy    String?
  companyName   String?   // Empresa asociada
  aiStatus      String    // Status original de Gemini (EN_ESPERA_DE_MATERIAL, SIN_SEGUIMIENTO, etc.)
  currentStatus String    @default("ABIERTO") // ABIERTO | EN_PROCESO | CERRADO | DESCARTADO
  groupId       String    // Grupo donde se envió
  sentDate      DateTime  // Fecha del reporte donde se envió

  // Feedback del coordinador (latest — kept for quick access)
  feedbackBy    String?   // Nombre del coordinador que respondió
  feedbackPhone String?   // Teléfono del coordinador
  feedbackText  String?   @db.Text
  feedbackAt    DateTime?

  // Progressive log of all updates
  logs          CriticalItemLog[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([groupId, sentDate])
  @@index([currentStatus])
}

model CriticalItemLog {
  id            String    @id @default(cuid())
  itemId        String
  item          CriticalItemTracking @relation(fields: [itemId], references: [id], onDelete: Cascade)
  status        String    // ABIERTO | EN_PROCESO | CERRADO | DESCARTADO
  updatedBy     String    // Nombre del coordinador
  updatedPhone  String?
  comment       String?   @db.Text
  createdAt     DateTime  @default(now())

  @@index([itemId])
}

model PerryIncidentPattern {
  id                  String   @id @default(cuid())
  title               String   // Título representativo de la incidencia/patrón
  category            String   // SEGURIDAD | LOGISTICA | COTIZACIONES | PERMISOS | RECURSOS | PROVEEDORES
  companyName         String?  // DROBOTS | OPUS INGENIUM | GRUPO CASEME | VULCAN FORGE | SAINPRO | MULTIEMPRESA
  groupId             String?
  incidentSummary     String   @db.Text // Descripción detallada de lo que está ocurriendo
  recurrenceCount     Int      @default(1) // Ocurrencias detectadas
  firstSeenAt         DateTime @default(now())
  lastSeenAt          DateTime @default(now())
  rawContextText      String   @db.Text // Transcripción/mensajes de origen
  aiAnalysis          String?  @db.Text // Análisis de causa raíz por Perry IA
  proposedImprovement String   @db.Text // Propuesta de solución operativa o de software
  copypastaPrompt     String   @db.Text // Contexto estructurado listo para copiar y pegar a Antigravity
  status              String   @default("DETECTADO") // DETECTADO | EN_PROGRESO | RESUELTO | ARCHIVADO
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyName])
  @@index([category])
  @@index([status])
}

// ─── CONTROL DE TESORERÍA Y SALDOS DIARIOS (ACCESO EXCLUSIVO IVAN LOPEZ) ───

model FinancialBalanceLog {
  id                 String   @id @default(cuid())
  groupId            String?
  companyName        String   // "GRUPO CASEME", "DROBOTS", "OPUS INGENIUM", "BEHEMOTH DESIGN"
  reportDate         DateTime @default(now())
  bankName           String   // "SANTANDER", "AFIRME", "BANORTE", "BBVA", "MONEX", etc.
  accountType        String   @default("MONEDA_NACIONAL") // "MONEDA_NACIONAL", "DOLARES", "CREDITO_REVOLVENTE", "INVERSION"
  currency           String   @default("MXN") // "MXN", "USD"
  initialBalance     Float    @default(0)
  income             Float    @default(0)
  expenses           Float    @default(0)
  finalBalance       Float    @default(0)
  isCalculatedMatch  Boolean  @default(true)
  calculatedDiff     Float    @default(0)
  rawMessage         String?  @db.Text
  imageUrl           String?  @db.Text
  parsedData         String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyName, reportDate])
  @@index([bankName])
}

// ─── API KEYS PARA INTEGRACIÓN EXTERNA (ACCESO EXCLUSIVO IVAN LOPEZ) ────────

model PerryApiKey {
  id          String    @id @default(cuid())
  name        String    // e.g. "Software Antigravity - Módulo Financiero Interno"
  key         String    @unique // e.g. "perry_sec_98f7a62bc..."
  createdBy   String    // Email of creator (Ivan Lopez)
  isActive    Boolean   @default(true)
  usageCount  Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([key])
}

// ─── CONTROL DE NÓMINAS Y FIRMAS DIGITALES TOKENIZADAS (ACCESO DIRECTIVO) ───

model PayrollLog {
  id                 String    @id @default(cuid())
  groupId            String?
  companyName        String    // "OPUS INGENIUM", "DROBOTS", "VULCAN FORGE", "GRUPO CASEME"
  periodNumber       String?   // e.g. "Raya 34", "Semana 34"
  reportDate         DateTime  @default(now())
  totalAmount        Float     @default(0)
  employeeCount      Int       @default(0)
  bankBreakdown      String?   @db.Text // JSON: [{ bankOrSource: string, amount: number }]
  observations       String?   @db.Text
  rawMessage         String?   @db.Text
  imageUrl           String?   @db.Text
  signedImageUrl     String?   @db.Text
  senderName         String?
  senderPhone        String?
  status             String    @default("PENDIENTE_FIRMA") // "PENDIENTE_FIRMA", "APROBADA_FIRMA_MANUAL", "APROBADA_TOKENIZADA", "RECHAZADA"
  signedBy           String?   // User / Director who authorized
  signedAt           DateTime?
  tokenHash          String?   @unique // Hash token for 1-click digital authorization URL
  ipAddress          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([companyName, reportDate])
  @@index([tokenHash])
  @@index([status])
}

// ─── PLAN DIARIO (LUNES A VIERNES) ─────────────────────────────────────────

model DailyWorkPlan {
  id           String   @id @default(cuid())
  planDate     DateTime
  companyName  String   // "GRUPO CASEME", "DROBOTS", "OPUS INGENIUM", "VULCAN FORGE"
  status       String   @default("PUBLICADO") // "BORRADOR", "PUBLICADO"
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activities      DailyWorkPlanActivity[]
  personnelStatus DailyWorkPlanPersonnelStatus[]

  @@unique([planDate, companyName])
  @@index([planDate])
  @@index([companyName])
}

model DailyWorkPlanActivity {
  id                  String   @id @default(cuid())
  dailyWorkPlanId     String
  dailyWorkPlan       DailyWorkPlan @relation(fields: [dailyWorkPlanId], references: [id], onDelete: Cascade)
  activityOrder       Int      @default(1)
  title               String   @db.Text
  assignedPersonnel   String   @db.Text // Comma list or text: "Jose Centeno, Mauricio Velazquez (Global Support)"
  dayOfWeek           String   // JUEVES, VIERNES, etc.
  startTime           String?  @default("08:00 AM")
  clientName          String?  
  supervisorOperativo String?
  supervisorCotizador String?
  supervisorTMMBC     String?  
  safetyDedicado      String?
  cotizacionFolio     String?  // e.g. "OS-408", "S02389"
  poNumber            String?  // e.g. "4520463471"
  isCrossSupport      Boolean  @default(false)
  crossSupportCompany String?  // e.g. "GLOBAL SUPPORT"
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([dailyWorkPlanId])
}

model DailyWorkPlanPersonnelStatus {
  id              String   @id @default(cuid())
  dailyWorkPlanId String
  dailyWorkPlan   DailyWorkPlan @relation(fields: [dailyWorkPlanId], references: [id], onDelete: Cascade)
  personName      String
  statusType      String   // "DESCANSO", "VACACIONES", "COMPRAS", "INCAPACIDAD", "OFICINA_PERRY"
  originCompany   String?  
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([dailyWorkPlanId])
}
